#
# bashrc/exports
# 
# dependencies
#   setadd
#
######

export PATH=`setadd $HOME/bin $HOME/.npm/packages/bin $PATH`
export LS='ls --color=auto --hide="lost+found"'
export CD='cd'
export CAT='cat'
export EDITOR='vim'
export CP='cp'
export RM='rm'
# red stderr >:)
[[ -f /usr/lib/libstderred.so ]] &&
  export LD_PRELOAD=`setadd $LD_PRELOAD /usr/lib/libstderred.so`

# the little daemon that remembers my ssh passphrase. socket activated,
# so systemd starts it the first time anything reaches for the socket
#   systemctl --user enable --now ssh-agent.socket
# how *long* it remembers is up to AddKeysToAgent in ~/.ssh/config
# (don't stomp on an agent we inherited, e.g. one forwarded over ssh)
[[ $XDG_RUNTIME_DIR ]] &&
  export SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-$XDG_RUNTIME_DIR/ssh-agent.socket}

red=$'\e[1;31m'
pink=$'\e[1;35m'
purple=$'\e[0;34m'
light=$'\e[0;37m'
green=$'\e[0;32m'
reset=$'\e[0m'

export C_RED=$red
export C_PINK=$pink
export C_LIGHT=$light
export C_BLUE=$blue
export C_STYLE=$purple
export C_GREEN=$green
export C_RESET=$reset

# dependencies
#   ok
#   whatbranch
#   batcolor
#   inception
#   [danger/time alias]
#   /bin/vim
export PS1=$'\[${red}\]`ok`\[${green}\]`whatbranch`\[${pink}\][`time` \u\[`batcolor`\]@\[${pink}\]\h \[${light}\]\w\[${pink}\]]`inception`\[${reset}\]$ '
