#
# bashrc/exports
# 
# dependencies
#   setadd
#
######

export PATH=`setadd $PATH $HOME/bin ./bin /ivos/bin $HOME/.npm/packages/bin`
export LS='ls --color=auto'
export CD='cd'
export CAT='cat'
export EDITOR='vim'
export CP='cp'
export RM='rm'
# red stderr >:)
[[ -f /usr/lib/libstderred.so ]] &&
  export LD_PRELOAD=`setadd $LD_PRELOAD /usr/lib/libstderred.so`

# Stop Claude Code asking the terminal to report mouse events. Without this it
# emits ESC[?1000h + ESC[?1006h at startup and every click/wheel/drag comes back
# as escape-sequence garbage in the prompt.
export CLAUDE_CODE_DISABLE_MOUSE=1

# iv/os: which tree am i? dev (/ivos, the repo) unless told otherwise.
# NODE_ENV=production picks the deployed copy at /ivy/ivos — say it out loud,
# per-command (`NODE_ENV=production ivy`) or in the systemd unit. see root.js.
export NODE_ENV=development

red=$'\e[1;31m'
pink=$'\e[1;35m'
purple=$'\e[0;34m'
light=$'\e[0;37m'
green=$'\e[0;32m'
reset=$'\e[0m'

export C_RED=$red
export C_PINK=$pink
export C_LIGHT=$light
export C_BLUE=$blue
export C_STYLE=$purple
export C_GREEN=$green
export C_RESET=$reset

# dependencies
#   ok
#   whatbranch
#   batcolor
#   inception
#   whatbrain
#   spent
#   [danger/time alias]
#   /bin/vim
export PS1=$'\[${red}\]`ok` \[${purple}\]`/ivy/bin/tools/tags -H`\n\[${green}\]`whatbranch`\[${pink}\][`time` \u\[`batcolor`\]@\[${pink}\]`whatbrain` \[${light}\]\w\[${pink}\]]`inception`\[${reset}\] \[${light}\]`spent`\[${reset}\]\n$ '
