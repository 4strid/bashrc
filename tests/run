#!/bin/bash
#
# bashrc/tests/run
#
# does it still work? (the eternal question)
#
# sanity tests for the sharp edges -- the ones that broke silently and stayed
# broken for years, because nothing here ever gets *run*, it gets *sourced*
# into a shell you then use for a week before noticing.
#
# hermetic on purpose: $HOME is pointed at a scratch directory with its own
# .tryhardrc, so this passes the same way on any machine and doesn't care
# what Astrid's actual home looks like today.
#
# tests the checkout it lives in, not the installed one. run it from anywhere.
#
# Usage: tests/run
#        returns 0 if everything passed, 1 otherwise
#
# dependencies
#   bashrc/functions
#   bashrc/exports
#   bashrc/danger
#   bashrc/aliases
#   bashrc/shortcuts
#   bashrc/screen
#   /bin/mktemp
#   /bin/python3   (one AF_UNIX socket, to have something real for -S to find)
#
# claude, for 4strid (Astrid Ivy)
# 2026-07-31

REPO=$(dirname $(dirname $(realpath ${BASH_SOURCE[0]})))

PASS=0
FAIL=0

check () { # DESCRIPTION EXPECTED ACTUAL
  if [[ "$2" == "$3" ]]; then
    PASS=$((PASS + 1))
  else
    FAIL=$((FAIL + 1))
    echo "  FAIL $1"
    echo "        want [$2]"
    echo "        got  [$3]"
    return 1
  fi
}

section () {
  echo
  echo "== $1 =="
}

# ---------------------------------------------------------------- the scratch

SANDBOX=$(mktemp -d)
trap '/bin/rm -rf "$SANDBOX"' EXIT

mkdir -p "$SANDBOX/my docs/deep nest" "$SANDBOX/plain" "$SANDBOX/report dir"
touch "$SANDBOX/report"
# a file and a directory with the same prefix, which is the whole -d problem
cat > "$SANDBOX/.tryhardrc" <<'EOF'
_TRY_COMMON=("." ".." "$HOME" "/")
EOF

export HOME="$SANDBOX"

source "$REPO/functions"
source "$REPO/exports"

S="$SANDBOX"

# ------------------------------------------------------------------- syntax

section "syntax"
for f in bashrc functions exports aliases shortcuts reflekt shopts danger screen ; do
  check "bash -n $f" "" "$(bash -n "$REPO/$f" 2>&1)"
done

# ---------------------------------------------------------------------- cd+

section "cd+"

builtin cd "$S"; cd+ "$S/my docs" >/dev/null 2>&1
check "absolute path with a space" "$S/my docs" "$PWD"

builtin cd "$S"; cd+ "my docs" >/dev/null 2>&1
check "relative name with a space" "$S/my docs" "$PWD"

builtin cd "$S"; cd+ "my d" >/dev/null 2>&1
check "half-remembered name with a space" "$S/my docs" "$PWD"

builtin cd "$S"; cd+ report >/dev/null 2>&1
check "a directory beats a file of the same name" "$S/report dir" "$PWD"

builtin cd "$S"; cd+ "my docs" "deep nest" >/dev/null 2>&1
check "two spacey segments in one trip" "$S/my docs/deep nest" "$PWD"

builtin cd "$S"; cd+ "my docs" nope >/dev/null 2>&1; RC=$?
check "a bad segment rewinds the whole trip" "$S" "$PWD"
check "a bad segment returns 127" "127" "$RC"

builtin cd "$S"; cd+ >/dev/null 2>&1
check "no arguments goes home" "$HOME" "$PWD"

builtin cd "$S"; cd+ plain >/dev/null 2>&1
check "returns 0 on success" "0" "$?"

builtin cd "$S/plain"; cd+ .. >/dev/null 2>&1
check "cd+ .. still climbs" "$S" "$PWD"

# the two-step history only counts cd+ hops, so take three of them
builtin cd "$S"; cd+ "my docs" >/dev/null 2>&1
cd+ "$S/plain" >/dev/null 2>&1
cd+ -- >/dev/null 2>&1
check "cd+ -- goes back two" "$S" "$PWD"

builtin cd "$S"
check "nothing on stdout when not interactive" "" "$(cd+ plain)"

# ------------------------------------------------------------------ tryhard

section "tryhard"

builtin cd "$S"
check "-g finds a file" "report" "$(tryhard -g echo report 2>/dev/null)"
check "-d finds the directory instead" "./report dir" "$(tryhard -d -g echo report 2>/dev/null)"
check "-d refuses a plain file" "no dir here" \
  "$(tryhard -d -g echo 'no dir here' 2>/dev/null)"
# the mirror of -d, and what `v' leans on: a half-typed name must not land on
# a directory that merely starts the same way. unfound, it falls through
# untouched, so vim gets what you actually typed
check "-f refuses a directory" "docs" "$(tryhard -f -G echo docs 2>/dev/null)"
check "-f still finds a file" "report" "$(tryhard -f -g echo report 2>/dev/null)"
check "-G matches a substring with a space" "./my docs" \
  "$(tryhard -G echo docs 2>/dev/null)"
check "-r recurses into a spacey directory" "./my docs/deep nest" \
  "$(tryhard -d -r echo 'deep nest' 2>/dev/null)"
check "a multi-word command keeps its words" "a b ./my docs" \
  "$(tryhard -d -g echo 'a b' 'my d' 2>/dev/null)"
check "an exact relative path wins immediately" "plain" \
  "$(tryhard -d -g echo plain 2>/dev/null)"
check "unfindable target falls through to the command" "definitely_not_here" \
  "$(tryhard -d -g echo definitely_not_here 2>/dev/null)"

# deep enough that neither . nor .. can reach it, so $HOME is the one that does
builtin cd "$S/my docs/deep nest"
check "reaches \$HOME from elsewhere" "$HOME/plain" \
  "$(tryhard -d -g echo plain 2>/dev/null | head -1)"

# ------------------------------------------------------------------ tryfind

section "tryfind"

builtin cd "$S"
check "finds spacey directories" "./my docs" "$(tryfind -d -g 'my d' 2>/dev/null)"
check "-D takes a base directory with a space" "$S/my docs/deep nest" \
  "$(builtin cd /; tryfind -d -D "$S/my docs" -g deep 2>/dev/null)"

# -------------------------------------------------------------- interactive

# --norc so this is the repo's behavior and not whatever is installed.
# see CLAUDE.md: a plain `bash -ic` would have sourced ~/.bashrc first
section "interactive only"

INT() { # run BODY in an interactive shell with the repo loaded
  bash --norc --noprofile -ic "
    source $REPO/functions; source $REPO/exports; source $REPO/danger
    $1
  " 2>/dev/null
}

check "cd is aliased to cd+" "cd+" "$(INT 'alias cd | sed "s/.*=.//;s/.\$//"')"
check "cd lists the directory it landed in" "deep nest" \
  "$(INT "cd '$S/my docs'")"
check "and still lands there" "$S/my docs" \
  "$(INT "cd '$S/my docs' >/dev/null; echo \$PWD")"

# ------------------------------------------------------------------- exports

# what a child process inherits, and what it must not. every failure in this
# section is a silent one: a colour that's empty, a prompt that only breaks in
# somebody else's shell, a socket variable that points at a dead agent and so
# blames your ssh key for a stale environment
section "exports"

EXP () { # EXP BODY [ENV...] -- fresh shell, repo loaded, env per ENV
  local BODY="$1"
  shift
  env "$@" bash --norc --noprofile -c "
    source '$REPO/functions' >/dev/null 2>&1
    source '$REPO/exports'   >/dev/null 2>&1
    $BODY
  " 2>/dev/null
}

# a real AF_UNIX socket to stand in for the agent. bind() creates the file and
# it outlives the python that made it, which is all -S needs
mksock () { python3 -c 'import socket,sys
socket.socket(socket.AF_UNIX).bind(sys.argv[1])' "$1" ; }
mksock "$S/ssh-agent.socket"
mksock "$S/forwarded.socket"

check "no agent in the env: take the systemd one" "$S/ssh-agent.socket" \
  "$(EXP 'echo "$SSH_AUTH_SOCK"' -u SSH_AUTH_SOCK XDG_RUNTIME_DIR="$S")"
check "a dead socket is replaced, not believed" "$S/ssh-agent.socket" \
  "$(EXP 'echo "$SSH_AUTH_SOCK"' SSH_AUTH_SOCK="$S/hungup.socket" XDG_RUNTIME_DIR="$S")"
check "a live forwarded agent is left alone" "$S/forwarded.socket" \
  "$(EXP 'echo "$SSH_AUTH_SOCK"' SSH_AUTH_SOCK="$S/forwarded.socket" XDG_RUNTIME_DIR="$S")"
check "nothing to point at, nothing invented" "" \
  "$(EXP 'echo "$SSH_AUTH_SOCK"' -u SSH_AUTH_SOCK -u XDG_RUNTIME_DIR)"

# PS1 names five things this repo defines. exported, it outlives all of them:
# a child shell renders `command not found' and then hands `time' to the bash
# keyword, which times the prompt and prints real/user/sys into it
# grep -c prints its 0 and *exits 1* about it; the count is the answer either way
check "PS1 is not exported" "0" "$(EXP 'env | grep -c "^PS1="')"
check "a non-interactive shell gets one anyway (iv/os)" "yes" \
  "$(EXP '[[ $PS1 ]] && echo yes')"
check "so does an interactive one" "yes" \
  "$(INT '[[ $PS1 ]] && echo yes')"
# the export is what leaked it; sourcing bashrc is how you're meant to get it
check "a shell that never sourced us has no prompt of ours" "" \
  "$(EXP 'bash --norc --noprofile -c "echo \$PS1"')"

check "every colour has a value" "" \
  "$(EXP 'for V in C_RED C_PINK C_LIGHT C_BLUE C_STYLE C_GREEN C_RESET ; do
            [[ ${!V} ]] || printf "%s " "$V"
          done')"

check "~/bin goes ahead of the system" "$S/bin" "$(EXP 'echo "${PATH%%:*}"')"

# ------------------------------------------------------------ the little guys

# v and c are both "one screen per thing" -- v one per file, c one per working
# directory. the entire mechanism is the name they hand inscreen, so that name
# is what's worth pinning: get it wrong and you don't get an error, you get
# somebody else's session
section "the little guys"

source "$REPO/screen"
inscreen () { printf '%s' "$1" ; }   # the name is the whole story

check "c names the screen after the directory" "claude ~/my docs" \
  "$(builtin cd "$S/my docs"; screenclaude)"
check "arguments don't get a claude of their own" "claude ~/my docs" \
  "$(builtin cd "$S/my docs"; screenclaude --resume)"
check "a different directory is a different claude" "claude ~/plain" \
  "$(builtin cd "$S/plain"; screenclaude)"
check "v still names the screen after the file" "vim $S/report" \
  "$(builtin cd "$S"; screenvim report)"
check "v asks tryhard for files only" "alias v='tryhard -f -g screenvim'" \
  "$(bash --norc --noprofile -c '
      source "$1" >/dev/null 2>&1
      source "$2" >/dev/null 2>&1
      alias v
    ' _ "$REPO/functions" "$REPO/shortcuts")"

# ---------------------------------------------------------------- the guard

# the invariant from CLAUDE.md: `aliases` and `shortcuts` are sourced above the
# interactive guard, so nothing in them may shadow a real command or call sudo.
# break this and agent shells start hanging on prompts nobody can answer
section "the guard"

NAMES=$(bash --norc --noprofile -c \
  'source "$1"; source "$2"; compgen -a' _ "$REPO/aliases" "$REPO/shortcuts")

COLLISIONS=
for N in $NAMES ; do
  BIN=$(bash --norc --noprofile -c 'type -P "$1"' _ "$N" 2>/dev/null)
  KIND=$(bash --norc --noprofile -c 'type -t "$1"' _ "$N" 2>/dev/null)
  [[ $BIN ]] && COLLISIONS+="$N($BIN) "
  [[ $KIND == builtin || $KIND == keyword ]] && COLLISIONS+="$N($KIND) "
done
check "no alias above the guard shadows a real command" "" "$COLLISIONS"

# strip comments first, or the explanation of the rule trips the rule
SUDO=$(for f in functions exports aliases shortcuts reflekt ; do
    sed 's/#.*//' "$REPO/$f" | grep -Hn sudo | sed "s|^|$f:|"
  done)
check "no sudo above the guard" "" "$SUDO"

# ----------------------------------------------------------------------- fin

echo
if (( FAIL )); then
  echo "$PASS passed, $FAIL FAILED"
  exit 1
fi
echo "$PASS passed. we're fine"
