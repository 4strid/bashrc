#
# A shell within a shell within a...
#
# Returns 0 if not in a subshell, otherwise prints depth
# and returns that number as an error code
#
# 4strid (Astrid Ivy)
# 2019-01-21

inception () {
  local DEPTH=$(($SHLVL - 1))
  #[[ $TERM == xterm ]] &&
    #[[ ! $SSH_CONNECTION ]] &&
    #[[ ! $VIM_TERMINAL ]] &&
    #DEPTH=$(($DEPTH - 2))

  # this APPEARs to only be set in xterm
  # and conveniently, not in an SSH session!
