ls_or_cat () {
  if [[ ! $1 ]] || [[ $1 = -* ]]; then
    $LS --hide="lost+found" "$@"
  elif [[ -d $1 ]]; then
    $LS "$@"
  elif [[ -f $1 ]]; then
    $CAT "$@"
  else
    echo "$1: Not a file or directory" 1>&2
    return 127
  fi
}

