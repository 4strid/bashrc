#
# bashrc/shortcuts
# 
# little guys
#
# dependencies
#   tryhard
#   screenify    [bashrc/screen]
#   screenvim    [bashrc/screen]
#   screenclaude [bashrc/screen]
#   ~/bin/google
#   /bin/git
#   /bin/screen
#   ~/.npm/packages/bin/claude
#
#######

# google, in a screen named after the search, so a page you meant to
# come back to is still sitting there when you do
alias g='screenify google'
alias t='tryhard -g'
alias T='tryhard -G -r'
alias t!='tryhard -g `lastcmd`'
alias T!='tryhard -G -r `lastcmd`'
# vim, but in a screen named after whatever it's editing, one per file.
# -f because you are opening a *file*: without it a half-typed name can
# land on a directory that merely started the same way, and vim opens the
# netrw listing for it instead of the thing you meant
alias v='tryhard -f -g screenvim'
alias V='tryhard -G -r vim'
# claude, in a screen named after the directory it was started in, one
# per working directory -- same deal as v, for the same reason
alias c='screenclaude'
alias n='npm run'
alias :q='exit'
alias :e='v'
alias :cd='cd'

# git, typed at speed
alias gl='git log'
alias gs='git status'
alias ga='git add'
alias gaa='git add -A'
alias gm='git commit -m'
alias gp='git push'
