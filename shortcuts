#
# bashrc/shortcuts
# 
# little guys
#
# dependencies
#   tryhard
#   inscreen   [bashrc/screen]
#   screenify  [bashrc/screen]
#   screenvim  [bashrc/screen]
#   ~/bin/google
#   /bin/git
#   /bin/screen
#   ~/.npm/packages/bin/claude
#
#######

# google, in a screen named after the search, so a page you meant to
# come back to is still sitting there when you do
alias g='screenify google'
alias t='tryhard -g'
alias T='tryhard -G -r'
alias t!='tryhard -g `lastcmd`'
alias T!='tryhard -G -r `lastcmd`'
# vim, but in a screen named after whatever it's editing, one per file
alias v='tryhard -g screenvim'
alias V='tryhard -G -r vim'
# and one screen named "claude" to rule them all
alias c='inscreen claude claude'
alias n='npm run'
alias :q='exit'
alias :e='v'
alias :cd='cd'

# git, typed at speed
alias gl='git log'
alias gs='git status'
alias ga='git add'
alias gaa='git add -A'
alias gm='git commit -m'
alias gp='git push'
# every branch that isn't in yet, hauled in at once. it's an octopus merge,
# so it's all or nothing: if any two of them touched the same lines it
# refuses and puts you back exactly where you were, nothing half-merged.
# the trailing HEAD is a guard — with no branches left to take, a bare
# `git merge` would helpfully go merge your upstream instead
alias gall='git merge --no-ff $(git branch --format="%(refname:short)" --no-merged) HEAD'
