#
# bashrc/shortcuts
# 
# little guys
#
# dependencies
#   tryhard
#   screenify    [bashrc/screen]
#   screenvim    [bashrc/screen]
#   screenclaude [bashrc/screen]
#   ~/bin/google
#   /bin/git
#   /bin/screen
#   ~/.npm/packages/bin/claude
#
#######

# google, in a screen named after the search, so a page you meant to
# come back to is still sitting there when you do
alias g='screenify google'
alias t='tryhard -g'
alias T='tryhard -G -r'
alias t!='tryhard -g `lastcmd`'
alias T!='tryhard -G -r `lastcmd`'
# vim, but in a screen named after whatever it's editing, one per file.
# -f because you are opening a *file*: without it a half-typed name can
# land on a directory that merely started the same way, and vim opens the
# netrw listing for it instead of the thing you meant
alias v='tryhard -f -g screenvim'
alias V='tryhard -G -r vim'
# claude, in a screen named after the directory it was started in, one
# per working directory -- same deal as v, for the same reason
alias c='screenclaude'
alias n='npm run'
alias :q='exit'
alias :e='v'
alias :cd='cd'

# git, typed at speed
alias gl='git log'
# yes, this shadows ghostscript, and above the guard at that. won't fix: it's
# `git status' a hundred times a day and a postscript interpreter never. the
# real one is still there as /usr/bin/gs. tests/run waives it by name, so
# don't "fix" this by moving it to danger -- that would only hide it from the
# shell that types it
alias gs='git status'
alias ga='git add'
alias gA='git add -A'
alias gm='git commit -m'
alias gp='git push'
# every branch that isn't in yet, hauled in at once, octopus-style.
# it only backs out cleanly when it can fast-forward first — i.e. you're
# standing on a strict ancestor of everything you're taking. one commit of
# your own that they haven't got, and it does real merges instead: a
# conflict then leaves you half-merged like any other merge, head #1 staged
# and head #2's file in pieces. `git merge --abort` walks it back.
# do NOT `git reset` to escape — that drops MERGE_HEAD and leaves the
# markers sitting in your files with nothing left to abort.
# the trailing HEAD is a guard — with no branches left to take, a bare
# `git merge` would helpfully go merge your upstream instead
alias gall='git merge --no-ff $(git branch --format="%(refname:short)" --no-merged) HEAD'
alias gab='git merge --abort'
